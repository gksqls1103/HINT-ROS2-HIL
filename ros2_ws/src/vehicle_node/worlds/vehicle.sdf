<?xml version="1.0"?>
<!-- 기존 주행 경로를 유지한 8 km 도심 도로 월드. 도로망은 SDF 기본 형상으로 구성됩니다. -->
<sdf version="1.8"><world name="vehicle_world">
<physics name="physics" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
<plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
<plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
<plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
<light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>1 1 1 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction><cast_shadows>true</cast_shadows></light>
<scene><ambient>0.62 0.67 0.72 1</ambient><background>0.68 0.81 0.94 1</background><shadows>true</shadows></scene>
<model name="ground"><static>true</static><link name="ground"><collision name="ground"><geometry><plane><normal>0 0 1</normal><size>8200 8200</size></plane></geometry></collision><visual name="terrain"><pose>0 0 0.006 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>8200 8200</size></plane></geometry><material><ambient>0.25 0.42 0.24 1</ambient><diffuse>0.30 0.48 0.28 1</diffuse></material></visual></link></model>
