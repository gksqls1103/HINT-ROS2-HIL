<visual name="right_windows"><pose>-0.04 -0.202 0.318 0 0 0</pose><geometry><box><size>0.4 0.008 0.105</size></box></geometry><material><diffuse>0.08 0.17 0.22 1</diffuse></material></visual>
<visual name="front_grille"><pose>0.46 0 0.115 0 0 0</pose><geometry><box><size>0.012 0.28 0.08</size></box></geometry><material><diffuse>0.055 0.06 0.065 1</diffuse></material></visual>
<visual name="left_headlight"><pose>0.463 0.17 0.19 0 0 0</pose><geometry><box><size>0.013 0.09 0.045</size></box></geometry><material><diffuse>0.95 0.94 0.8 1</diffuse></material></visual>
<visual name="right_headlight"><pose>0.463 -0.17 0.19 0 0 0</pose><geometry><box><size>0.013 0.09 0.045</size></box></geometry><material><diffuse>0.95 0.94 0.8 1</diffuse></material></visual>
<visual name="left_tail_light"><pose>-0.462 0.17 0.2 0 0 0</pose><geometry><box><size>0.012 0.09 0.045</size></box></geometry><material><diffuse>0.85 0.06 0.04 1</diffuse></material></visual>
<visual name="right_tail_light"><pose>-0.462 -0.17 0.2 0 0 0</pose><geometry><box><size>0.012 0.09 0.045</size></box></geometry><material><diffuse>0.85 0.06 0.04 1</diffuse></material></visual>
</link>
<!-- 앞/뒤, 왼쪽/오른쪽의 실제 구동 바퀴 4개입니다. 캐스터는 사용하지 않습니다. -->
<!-- front_left_wheel: 반지름 0.2 m, 폭 0.08 m, 회전축은 차체 y 방향입니다. -->
<link name="front_left_wheel">
  <pose>0.28 0.28 0 1.57079632679 0 0</pose>
  <inertial><mass>0.5</mass><inertia><ixx>0.005267</ixx><iyy>0.005267</iyy><izz>0.01</izz></inertia></inertial>
  <collision name="wheel_collision">
    <!-- 외형 폭은 8 cm, 접지부 충돌 폭은 2 cm로 근사해 모서리 접촉 오차를 줄입니다. -->
    <geometry><cylinder><radius>0.2</radius><length>0.02</length></cylinder></geometry>
    <!-- 타이어의 진행 방향 접지와 회전에 필요한 횡방향 미끄러짐을 구분합니다. -->
    <surface><friction><ode><mu>0.01</mu><mu2>1.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface>
  </collision>
  <visual name="wheel_visual">
    <geometry><cylinder><radius>0.2</radius><length>0.08</length></cylinder></geometry>
    <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
  </visual>
</link>
<joint name="front_left_wheel_joint" type="revolute">
  <parent>base_link</parent><child>front_left_wheel</child>
  <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
</joint>
<!-- rear_left_wheel: 반지름 0.2 m, 폭 0.08 m, 회전축은 차체 y 방향입니다. -->
<link name="rear_left_wheel">
  <pose>-0.28 0.28 0 1.57079632679 0 0</pose>
  <inertial><mass>0.5</mass><inertia><ixx>0.005267</ixx><iyy>0.005267</iyy><izz>0.01</izz></inertia></inertial>
  <collision name="wheel_collision">
    <!-- 외형 폭은 8 cm, 접지부 충돌 폭은 2 cm로 근사해 모서리 접촉 오차를 줄입니다. -->
    <geometry><cylinder><radius>0.2</radius><length>0.02</length></cylinder></geometry>
    <!-- 타이어의 진행 방향 접지와 회전에 필요한 횡방향 미끄러짐을 구분합니다. -->
    <surface><friction><ode><mu>0.01</mu><mu2>1.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface>
  </collision>
  <visual name="wheel_visual">
    <geometry><cylinder><radius>0.2</radius><length>0.08</length></cylinder></geometry>
    <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
  </visual>
</link>
<joint name="rear_left_wheel_joint" type="revolute">
  <parent>base_link</parent><child>rear_left_wheel</child>
  <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
</joint>
<!-- front_right_wheel: 반지름 0.2 m, 폭 0.08 m, 회전축은 차체 y 방향입니다. -->
<link name="front_right_wheel">
  <pose>0.28 -0.28 0 1.57079632679 0 0</pose>
  <inertial><mass>0.5</mass><inertia><ixx>0.005267</ixx><iyy>0.005267</iyy><izz>0.01</izz></inertia></inertial>
  <collision name="wheel_collision">
    <!-- 외형 폭은 8 cm, 접지부 충돌 폭은 2 cm로 근사해 모서리 접촉 오차를 줄입니다. -->
    <geometry><cylinder><radius>0.2</radius><length>0.02</length></cylinder></geometry>
    <!-- 타이어의 진행 방향 접지와 회전에 필요한 횡방향 미끄러짐을 구분합니다. -->
    <surface><friction><ode><mu>0.01</mu><mu2>1.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface>
  </collision>
  <visual name="wheel_visual">
    <geometry><cylinder><radius>0.2</radius><length>0.08</length></cylinder></geometry>
    <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
  </visual>
</link>
<joint name="front_right_wheel_joint" type="revolute">
  <parent>base_link</parent><child>front_right_wheel</child>
  <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
</joint>
<!-- rear_right_wheel: 반지름 0.2 m, 폭 0.08 m, 회전축은 차체 y 방향입니다. -->
<link name="rear_right_wheel">
  <pose>-0.28 -0.28 0 1.57079632679 0 0</pose>
  <inertial><mass>0.5</mass><inertia><ixx>0.005267</ixx><iyy>0.005267</iyy><izz>0.01</izz></inertia></inertial>
  <collision name="wheel_collision">
    <!-- 외형 폭은 8 cm, 접지부 충돌 폭은 2 cm로 근사해 모서리 접촉 오차를 줄입니다. -->
    <geometry><cylinder><radius>0.2</radius><length>0.02</length></cylinder></geometry>
    <!-- 타이어의 진행 방향 접지와 회전에 필요한 횡방향 미끄러짐을 구분합니다. -->
    <surface><friction><ode><mu>0.01</mu><mu2>1.0</mu2><fdir1>0 0 1</fdir1></ode></friction></surface>
  </collision>
  <visual name="wheel_visual">
    <geometry><cylinder><radius>0.2</radius><length>0.08</length></cylinder></geometry>
    <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
  </visual>
</link>
<joint name="rear_right_wheel_joint" type="revolute">
  <parent>base_link</parent><child>rear_right_wheel</child>
  <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
</joint>
<!-- 차동구동은 Twist 명령을 좌우 바퀴 속도로 변환합니다. -->
<plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
<!-- 같은 쪽 앞뒤 바퀴에 동일한 속도를 적용하는 4륜 차동구동입니다. -->
<left_joint>front_left_wheel_joint</left_joint><left_joint>rear_left_wheel_joint</left_joint>
<right_joint>front_right_wheel_joint</right_joint><right_joint>rear_right_wheel_joint</right_joint>
<wheel_separation>0.56</wheel_separation><wheel_radius>0.2</wheel_radius>
<topic>/model/vehicle/cmd_vel</topic><odom_topic>/model/vehicle/odometry</odom_topic>
<odom_publish_frequency>20</odom_publish_frequency><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
</plugin>
<!-- 바퀴가 헛도는 경우를 검출하기 위한 검증용 월드 위치 피드백입니다. -->
<plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
  <odom_topic>/model/vehicle/ground_truth</odom_topic>
  <odom_frame>world</odom_frame><robot_base_frame>base_link</robot_base_frame>
  <odom_publish_frequency>20</odom_publish_frequency><dimensions>2</dimensions>
</plugin>
</model></world></sdf>
