# 모든 담당자가 같은 ROS 2 통신 그룹을 사용하도록 동일하게 설정합니다.
ROS_DOMAIN_ID=42
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# Cyclone DDS 기본 인터페이스는 docker-compose.yml에서 eth0로 지정합니다.
# 다른 LAN 인터페이스를 써야 하면 아래 설정의 name 값을 바꿔 지정하세요.
# CYCLONEDDS_URI=<CycloneDDS><Domain><General><Interfaces><NetworkInterface name="eth0" multicast="true"/></Interfaces></General></Domain></CycloneDDS>

# B(Vision) 담당자: 실제 카메라 장치 경로에 맞게 수정합니다.
VISION_CAMERA_DEVICE=/dev/video0

# C(Safety) 담당자: /dev/ttyUSB0 또는 /dev/ttyACM0으로 수정합니다.
SAFETY_SERIAL_DEVICE=/dev/ttyUSB0
