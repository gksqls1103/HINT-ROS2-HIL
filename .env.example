# 모든 담당자가 같은 ROS 2 통신 그룹을 사용하도록 동일하게 설정합니다.
ROS_DOMAIN_ID=42
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# B(Vision) 담당자: 실제 카메라 장치 경로에 맞게 수정합니다.
VISION_CAMERA_DEVICE=/dev/video0

# C(Safety) 담당자: /dev/ttyUSB0 또는 /dev/ttyACM0으로 수정합니다.
SAFETY_SERIAL_DEVICE=/dev/ttyUSB0

# 멀티캐스트가 막힌 Wi-Fi에서는 통신할 상대 장비 IP를 쉼표로 적습니다. (비우면 멀티캐스트 탐색)
# 예: D는 A,B,C의 IP를 모두, A/B/C는 D의 IP를 적습니다. 통신하는 장비끼리는 서로 등록해야 합니다.
CYCLONEDDS_PEERS=
# 네트워크 인터페이스가 여러 개인 장비는 사용할 자기 IP(또는 이름)를 적습니다. (비우면 자동 선택)
CYCLONEDDS_INTERFACE=
